{% extends 'base.html.twig' %}

{# `libelle_de` porte son espace final quand il en faut un : « des » suivi d'un
   espace, « de l' » sans. Il se concatène donc au nom sans rien ajouter. #}
{% set nom_article = departement.libelle_de ~ departement.nom %}
{% set titre = departement.code == '099'
  ? 'Députés ' ~ nom_article
  : 'Députés ' ~ nom_article ~ ' (' ~ departement.code ~ ')' %}

{% block title %}Députés par circonscription : {{ departement.nom }} {{ departement.code }} | Datan{% endblock %}

{% block meta_description %}Découvrez la liste des députés élus dans le département {{ nom_article }} ({{ departement.code }}). Tous les députés des circonscriptions {{ nom_article }}.{% endblock %}

{% block body %}
<div class="container-fluid bloc-img-deputes bloc-img d-flex async_background" id="container-always-fluid" style="height: 13em">
  <div class="container d-flex flex-column justify-content-center py-2">
    <h1>{{ titre }}</h1>
  </div>
</div>
<div class="container pg-departement my-5">
  <div class="row">
    <div class="col-12">
      <h2>Découvrez les députés {{ nom_article }} à l'Assemblée nationale</h2>
    </div>
  </div>
  <div class="row mt-5">
    <div class="col-12 d-flex flex-wrap justify-content-around">
      {% for depute in deputes %}
        {% embed 'depute/partials/card_decouverte.html.twig' with {tag: 'h3'} %}
          {% block centre %}{{ depute.circonscription }}<sup>{{ depute.circonscription|rang_circo }}</sup> circonscription{% endblock %}
        {% endembed %}
      {% endfor %}
    </div>
  </div>
</div>
{% if communes %}
  {{ include('departement/partials/communes.html.twig') }}
{% endif %}
{% endblock %}
