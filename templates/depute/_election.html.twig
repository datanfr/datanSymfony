{# Bloc « Son élection », porté de views/deputes/partials/mp_individual/_election.php.
   La règle de substitution (partielle → élection générale), le regroupement
   « Autres candidats » au premier tour et le calcul de participation vivent dans
   ResultatCirconscriptionRepository : ce gabarit ne fait qu'afficher. #}
{% set e = depute.civilite == 'Mme' ? 'e' : '' %}
<div class="mt-5 bloc-election">
  <h2>Son élection</h2>
  <div class="card mt-4">
    <div class="card-body">
      <p>
        {{ depute.firstname }} {{ depute.lastname }} a été élu{{ e }} député{{ e }} lors du {{ election.tour_libelle }} tour
        {%- if election.partielle %} d'une élection législative partielle
        {%- else %} des élections législatives de {{ election.annee }}
        {%- endif %}
        avec <b>{{ election.elu.voix|number_format(0, ',', ' ') }}</b> voix, soit {{ election.elu.part|round }} % des suffrages exprimés.
      </p>

      {% if election.participation %}
        {# Le legacy écrit « supérieux » (coquille) ; on rétablit « supérieur ». #}
        {% set comparaison = election.participation.taux > election.participation.nationale
             ? 'supérieur'
             : (election.participation.taux < election.participation.nationale ? 'inférieur' : 'égal') %}
        <p>
          La participation au {{ election.tour_libelle }} tour a atteint {{ election.participation.taux }} % dans cette
          circonscription, un taux {{ comparaison }} à la moyenne nationale ({{ election.participation.nationale }} %).
        </p>
      {% endif %}

      {% if election.partielle %}
        <p>{{ depute.firstname }} {{ depute.lastname }} a été élu{{ e }} lors d'une élection partielle qui s'est tenue en {{ election.date_partielle }}.</p>
      {% endif %}

      <div class="mt-4">
        <p class="subtitle">
          Résultats du {{ election.tour_libelle }} tour —
          {%- if election.partielle %} Élection législative partielle {{ election.annee }}
          {%- else %} Élections législatives {{ election.annee }}{% endif %}
        </p>

        {# Encadré de l'élu : fond vert Datan translucide, badge « Élu·e ». #}
        <div class="border border-primary rounded px-3 py-4 mt-4" style="background-color: rgba(0, 183, 148, 0.15);">
          <div class="d-flex justify-content-between">
            <h3 class="mt-0 font-weight-bold candidate">{{ election.elu.candidat }}<span class="badge badge-primary ml-2">Élu{{ e }}</span></h3>
            <strong>{{ election.elu.part|number_format(1, ',', ' ') }} %</strong>
          </div>
          <div class="d-flex align-items-center mb-1">
            <small class="text-muted">{{ election.elu.voix|number_format(0, ',', ' ') }} voix</small>
          </div>
          <div class="progress" style="height: 10px;">
            <div class="progress-bar bg-primary candidate" role="progressbar" style="width: {{ election.elu.part|round }}%;"
                 aria-valuenow="{{ election.elu.part|round }}" aria-valuemin="0" aria-valuemax="100"
                 aria-label="Pourcentage de voix remportées par {{ election.elu.candidat }}"></div>
          </div>
        </div>

        {# Concurrents du même tour, du plus au moins voté. #}
        {% for adversaire in election.adversaires %}
          <div class="mt-4 px-3">
            <div class="d-flex justify-content-between">
              <h3 class="mt-0 font-weight-bold candidate">{{ adversaire.candidat }}</h3>
              <strong>{{ adversaire.part|number_format(1, ',', ' ') }} %</strong>
            </div>
            <div class="d-flex align-items-center mb-1">
              <small class="text-muted">{{ adversaire.voix|number_format(0, ',', ' ') }} voix</small>
            </div>
            <div class="progress" style="height: 10px;">
              <div class="progress-bar bg-primary" role="progressbar" style="width: {{ adversaire.part|round }}%;"
                   aria-valuenow="{{ adversaire.part|round }}" aria-valuemin="0" aria-valuemax="100"
                   aria-label="Pourcentage de voix remportées par {{ adversaire.candidat }}"></div>
            </div>
          </div>
        {% endfor %}

        {% if election.lien %}
          {# Le legacy masque cette URL derrière un déchiffrement JS anti-scraping ;
             elle pointe une archive publique et générique du ministère — on sert un
             lien simple plutôt que de réimplanter ce mécanisme. #}
          <div class="mt-4">
            <a class="no-decoration underline" href="{{ election.lien }}" target="_blank" rel="noopener">🔎 Consultez les résultats complets</a>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
