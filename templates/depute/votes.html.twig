{% extends 'base.html.twig' %}

{% set nom_complet = depute.firstname ~ ' ' ~ depute.lastname %}
{% set femme = depute.civilite == 'Mme' %}
{% set e = femme ? 'e' : '' %}
{% set profil = path('depute_individual', {dptSlug: depute.dpt_slug, slug: depute.slug}) %}

{% block title %}{{ nom_complet }} - Votes | Datan{% endblock %}

{% block meta_description %}Découvrez toutes les positions {{ femme ? 'de la' : 'du' }} député{{ e }} {{ nom_complet }} quand {{ femme ? 'elle' : 'il' }} vote à l'Assemblée nationale.{% endblock %}

{% block body %}
<div class="container-fluid bloc-img-deputes async_background d-flex" id="container-always-fluid" style="height: 13em"></div>
{% if depute.groupe_couleur %}
  <div class="liseret-groupe" style="background-color: {{ depute.groupe_couleur }}"></div>
{% endif %}

<div class="container pg-groupe-votes mb-5">
  <div class="row">
    <div class="col-lg-4 d-none d-lg-block">
      <div class="sticky-top mt-5" style="top: 125px">
        <div class="card">
          <div class="card-body text-center">
            <div class="d-flex justify-content-center">
              <div class="depute-img-circle">
                <img src="{{ photo_depute(depute) }}" width="130" height="166" alt="{{ nom_complet }}">
              </div>
            </div>
            <p class="title mt-2 mb-0">{{ nom_complet }}</p>
            {% if depute.groupe_libelle %}
              <p class="mb-0 small" style="color: {{ depute.groupe_couleur }}">{{ depute.groupe_libelle|name_group }}</p>
            {% endif %}
            <a class="btn btn-outline-primary mt-3" href="{{ profil }}">Retour profil</a>
          </div>
        </div>

        {% if categories %}
          <div class="card mt-3">
            <div class="card-body badges-filter px-4 py-3">
              <span class="title">Filtrer par catégorie</span>
              <div class="filters">
                <div class="mt-2">
                  {% for slug, nom in categories %}
                    <button type="button" class="badge badge-field popover_focus is-selected" value=".{{ slug }}">{{ nom }}</button>
                  {% endfor %}
                </div>
                <div class="mt-2">
                  <button type="button" class="btn btn-primary all-categories" value="*">Toutes les catégories</button>
                </div>
              </div>
            </div>
          </div>
          <div class="card mt-3">
            <div class="card-body badges-filter px-4 py-3">
              <input type="text" id="quicksearch" placeholder="Cherchez un vote...">
            </div>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="col-md-10 col-lg-8 offset-md-1 offset-lg-0 pl-lg-5 bloc-votes-datan">
      <div class="d-lg-none btn-back mt-4">
        <a class="btn btn-outline-primary" href="{{ profil }}">Retour profil</a>
      </div>
      <h1 class="mb-4 mt-4">Les votes de {{ nom_complet }} à l'Assemblée nationale</h1>
      <p>
        L'équipe de Datan décrypte les votes les plus intéressants de la législature et les
        remet en contexte. Vous trouverez ici la position que {{ nom_complet }}
        {{ actif ? 'a prise' : 'avait prise' }} sur chacun d'eux, puis la liste complète des
        scrutins où {{ femme ? 'elle' : 'il' }} s'est exprimé{{ e }}.
      </p>

      {% if decryptes %}
        <h2 class="mt-4">Découvrez les <span class="text-primary">{{ decryptes|length }} vote{{ decryptes|length > 1 ? 's' : '' }}</span> décryptés de {{ nom_complet }}</h2>
        <div class="row mt-4 sorting">
          {% for vote in decryptes %}
            <div class="col-md-6 sorting-item {{ vote.categorie_slug }}">
              <div class="d-flex justify-content-center my-3">
                <div class="card card-vote">
                  <div class="thumb d-flex align-items-center {{ vote.position }}">
                    <div class="d-flex align-items-center">
                      <span>{{ vote.position|upper }}</span>
                    </div>
                  </div>
                  <div class="card-header d-flex flex-row justify-content-between">
                    <span class="date">{{ vote.date_scrutin|date_abregee }}</span>
                  </div>
                  <div class="card-body d-flex flex-column justify-content-center">
                    <span class="title">
                      <a href="{{ lien_vote(vote.legislature, vote.vote_numero) }}" class="stretched-link underline no-decoration">{{ vote.title }}</a>
                    </span>
                    {% if vote.lecture_name %}
                      <span class="reading mt-2">{{ vote.lecture_name }}</span>
                    {% endif %}
                  </div>
                  {# L'explication de vote est écrite par le député lui-même : c'est
                     une parole rapportée, jamais une analyse de la rédaction. #}
                  {% if vote.explication %}
                    <div class="explication py-2 px-3">
                      <span class="d-block small font-weight-bold mb-1">L'avis {{ femme ? 'de la' : 'du' }} député{{ e }}</span>
                      <span class="d-block small font-italic">{{ vote.explication }}</span>
                    </div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
        </div>
      {% endif %}

      <h2 class="mt-5">Tous les votes de {{ nom_complet }}</h2>
      <p class="small">
        {{ tous_les_votes|length }} scrutin{{ tous_les_votes|length > 1 ? 's' : '' }} où
        {{ femme ? 'elle' : 'il' }} s'est exprimé{{ e }}. La loyauté compare {{ femme ? 'son' : 'son' }} vote
        à la position majoritaire de son groupe <b>au moment du scrutin</b>.
      </p>
      <table class="table" id="table-deputes-groupes-votes-all">
        <caption class="sr-only">Tous les votes de {{ nom_complet }}</caption>
        <thead>
          <tr>
            <th scope="col" class="all">Lég.</th>
            <th scope="col" class="all">N°</th>
            <th scope="col" class="min-tablet">Date</th>
            <th scope="col" class="all">Titre</th>
            <th scope="col" class="text-center all">Vote</th>
            <th scope="col" class="text-center all">Loyauté</th>
          </tr>
        </thead>
        <tbody>
          {% for vote in tous_les_votes %}
            {% set url = lien_vote(vote.legislature, vote.numero) %}
            {% set numero = vote.numero|congress_numero %}
            <tr data-href="{{ url }}">
              <td>{{ vote.legislature }}</td>
              {# Seules les premières lignes portent une ancre : la page en compte
                 des milliers. Les autres restent cliquables par la ligne. #}
              <td>{% if loop.index <= 30 %}<a class="no-decoration" href="{{ url }}">{{ numero }}</a>{% else %}{{ numero }}{% endif %}</td>
              <td>{{ vote.date_scrutin }}</td>
              <td>
                {% if vote.decryptage_title %}
                  <span class="vote-datan-bold">{{ vote.decryptage_title }}</span><br>
                {% endif %}
                <span class="{{ vote.decryptage_title ? 'vote-datan-italic' : '' }}">{{ vote.titre }}</span>
              </td>
              <td class="sort text-center sort-{{ vote.position }}">{{ vote.position|upper }}</td>
              <td class="sort text-center sort-{{ vote.loyaute }}">{{ vote.loyaute ? vote.loyaute|upper ~ e|upper : '' }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>
{% endblock %}

{% block javascripts_libraries %}
  <script src="{{ asset('assets/js/libraries/isotope/isotope.pkgd.min.js') }}"></script>
{% endblock %}

{% block javascripts %}
  <script src="{{ asset('assets/js/datan/sorting.js') }}"></script>
  <script src="{{ asset('assets/js/libraries/moment/moment.min.js') }}"></script>
  <script src="{{ asset('assets/js/dist/datatable-datan.min.js') }}"></script>
  <script src="{{ asset('assets/js/libraries/datetime/datetime-moment.js') }}"></script>
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      document.querySelectorAll('tr[data-href]').forEach((ligne) => {
        ligne.addEventListener('click', () => { window.location.href = ligne.dataset.href; });
      });
    });
  </script>
{% endblock %}
