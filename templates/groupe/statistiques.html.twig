{% extends 'base.html.twig' %}

{% set nom_groupe = groupe.libelle|name_group %}
{% set actif = groupe.date_fin is null %}
{% set couleur = groupe.couleur ?: '#00668e' %}

{% block title %}{{ nom_groupe }} ({{ groupe.libelle_abrev }}) - Statistiques - Datan{% endblock %}

{% block meta_description %}Cohésion, participation et proximité avec les autres groupes : les statistiques de vote du groupe {{ nom_groupe }} ({{ groupe.libelle_abrev }}) à l'Assemblée nationale.{% endblock %}

{% block body %}
{{ include('groupe/partials/entete_sous_page.html.twig') }}

<div class="container pg-groupe-individual mb-5">
  <div class="row">
    <div class="col-12">
      <div class="d-none d-lg-block btn-back mt-4">
        <a class="btn btn-outline-primary mx-2" href="{{ path('groupe_individual', {legislature: groupe.legislature, abrev: groupe.libelle_abrev|lower}) }}">Retour profil</a>
      </div>
      <h1 class="mb-4 mt-4">Les statistiques {{ groupe.libelle_abrev == 'NI' ? 'des députés non inscrits' : 'du groupe ' ~ nom_groupe }}</h1>
      <p>
        Ces mesures portent sur les <b>{{ comportement.scrutins }} scrutins</b> auxquels
        {{ actif ? 'le groupe prend part' : 'le groupe a pris part' }} pendant la {{ groupe.legislature }}<sup>e</sup> législature.
      </p>
    </div>
  </div>

  <div class="row mt-4" id="cohesion">
    <div class="col-md-6 mb-3">
      <div class="card h-100">
        <div class="card-body text-center">
          <h2 class="subtitle h5">Taux de cohésion</h2>
          <p class="display-4 mb-1" style="color: {{ couleur }}">{{ comportement.cohesion_moyenne is not null ? comportement.cohesion_moyenne|round(2) : '—' }}</p>
          <p class="mb-0 small">moyenne sur {{ comportement.scrutins }} scrutins</p>
          <p class="mt-3 mb-0 small font-italic">
            Le taux de cohésion représente l'unité d'un groupe politique lorsqu'il vote, de 0 à 1.
            Un taux proche de 1 signifie que le groupe est très uni. Dans la plupart des parlements,
            l'Assemblée comprise, les députés suivent la ligne de leur groupe : la mesure prend
            surtout son sens comparée à celle des autres groupes.
          </p>
        </div>
      </div>
    </div>
    <div class="col-md-6 mb-3" id="participation">
      <div class="card h-100">
        <div class="card-body text-center">
          <h2 class="subtitle h5">Taux de participation</h2>
          <p class="display-4 mb-1" style="color: {{ couleur }}">{{ comportement.participation_moyenne is not null ? comportement.participation_moyenne ~ ' %' : '—' }}</p>
          <p class="mb-0 small">part moyenne des membres prenant part au vote</p>
          <p class="mt-3 mb-0 small font-italic">
            Ce score prend en compte tous les scrutins publics. Il est faible du fait de
            l'organisation du travail à l'Assemblée : les votes s'y déroulent à n'importe quel
            moment de la semaine, souvent pendant d'autres réunions.
          </p>
        </div>
      </div>
    </div>
  </div>

  {% if majorite %}
    <div class="mt-5" id="majorite">
      <h2 class="mb-3">Proximité avec la majorité présidentielle</h2>
      <div class="card card-statistiques border-0">
        <div class="card-body">
          <p class="mb-0">
            Sur les {{ majorite.votes }} scrutins où les deux groupes se sont exprimés,
            {{ nom_groupe }} {{ actif ? 'a voté' : 'avait voté' }} dans le même sens que
            <a class="no-decoration underline" href="{{ path('groupe_individual', {legislature: majorite.legislature, abrev: majorite.libelle_abrev|lower}) }}">{{ majorite.libelle|name_group }}</a>
            dans <b>{{ majorite.score }} % des cas</b>.
          </p>
        </div>
      </div>
    </div>
  {% endif %}

  {% if coalitions %}
    <div class="mt-5" id="coalitions">
      <h2 class="mb-3">Coalitions les plus fréquentes</h2>
      <div class="card card-statistiques border-0 mb-3">
        <div class="card-body">
          <p>
            Dans une Assemblée nationale où aucun groupe n'a la majorité absolue, les coalitions
            sont essentielles pour faire adopter des textes. Avec quels groupes
            {{ groupe.libelle_abrev }} {{ actif ? 's\'associe-t-il' : 's\'associait-il' }} lors des votes ?
          </p>
          {% if coalition_blocs %}
            <p class="mb-0">
              La coalition avec laquelle le groupe {{ groupe.libelle_abrev }}
              {{ actif ? 'a le plus fréquemment voté' : 'avait le plus fréquemment voté' }}
              ({{ coalitions[0].votes }} scrutins) est composée de groupes
              {%- for bloc in coalition_blocs %}
                {{- loop.first ? ' ' : (loop.last ? ' et ' : ', ') }}
                {{- bloc.preposition }}<b>{{ bloc.nom }}</b> ({{ bloc.sigles|join(', ') }})
              {%- endfor -%}.
            </p>
          {% endif %}
        </div>
      </div>

      <table class="table table-striped table-vote-individual" style="width: 100%">
        <caption class="sr-only">Coalitions les plus fréquentes du groupe {{ groupe.libelle_abrev }}</caption>
        <thead>
          <tr>
            <th scope="col" class="all">Groupes ayant voté ensemble</th>
            <th scope="col" class="text-center all">Scrutins</th>
          </tr>
        </thead>
        <tbody>
          {% for coalition in coalitions %}
            <tr>
              <td>
                {% for sigle in coalition.sigles %}
                  <span class="badge mr-1" style="background-color: {{ coalitions_couleurs[sigle]|default('#6c757d') }}; color: #fff">{{ sigle }}</span>
                {% endfor %}
              </td>
              <td class="text-center"><b>{{ coalition.votes }}</b></td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}

  {% if proximites %}
    <div class="mt-5" id="proximite">
      <h2 class="mb-3">Proximité avec les autres groupes</h2>
      <div class="card card-statistiques border-0 mb-3">
        <div class="card-body">
          {% if plus_proche %}
            <p>
              Le groupe dont {{ nom_groupe }} {{ actif ? 'est' : 'était' }} le plus proche
              {{ actif ? 'est' : 'était' }}
              <a class="no-decoration underline" href="{{ path('groupe_individual', {legislature: plus_proche.legislature, abrev: plus_proche.libelle_abrev|lower}) }}">{{ plus_proche.libelle|name_group }}</a>,
              avec <b>{{ plus_proche.score }} %</b> de votes identiques.
            </p>
          {% endif %}
          {% if plus_eloigne %}
            <p class="mb-0">
              À l'opposé, c'{{ actif ? 'est' : 'était' }}
              <a class="no-decoration underline" href="{{ path('groupe_individual', {legislature: plus_eloigne.legislature, abrev: plus_eloigne.libelle_abrev|lower}) }}">{{ plus_eloigne.libelle|name_group }}</a>
              qui {{ actif ? 'en est' : 'en était' }} le plus éloigné, avec <b>{{ plus_eloigne.score }} %</b>.
            </p>
          {% endif %}
          <p class="mt-3 mb-0 small font-italic">
            Le taux de proximité entre deux groupes est le pourcentage de scrutins où ils ont
            voté dans le même sens. Deux groupes sont comptés d'accord lorsqu'ils ont voté
            <i>pour</i> tous les deux, ou <i>contre</i> tous les deux.
          </p>
        </div>
      </div>

      {% if proximite_mensuelle.series %}
        <div class="card card-statistiques border-0 mb-3">
          <div class="card-body">
            <h3 class="h6">Mois par mois</h3>
            <p class="small">
              La moyenne d'une législature masque les recompositions : un groupe peut s'éloigner
              d'un autre au fil des mois sans que le total le laisse voir.
            </p>
            <div style="width: 100%">
              <canvas id="proximite-mensuelle"></canvas>
            </div>
          </div>
        </div>
      {% endif %}

      <table class="table table-striped table-vote-individual" style="width: 100%">
        <caption class="sr-only">Proximité du groupe {{ groupe.libelle_abrev }} avec les autres groupes</caption>
        <thead>
          <tr>
            <th scope="col" class="all">Groupe</th>
            <th scope="col" class="text-center all">Votes identiques</th>
            <th scope="col" class="text-center min-tablet">Scrutins communs</th>
          </tr>
        </thead>
        <tbody>
          {% for p in proximites %}
            <tr>
              <td class="name">
                <span class="liseret-inline" style="display:inline-block;width:.5rem;height:1rem;background-color:{{ p.couleur }};vertical-align:middle"></span>
                <a class="no-decoration underline ml-2" href="{{ path('groupe_individual', {legislature: p.legislature, abrev: p.libelle_abrev|lower}) }}">{{ p.libelle|name_group }}</a>
                <span class="text-muted">({{ p.libelle_abrev }})</span>
              </td>
              <td class="text-center"><b>{{ p.score }} %</b></td>
              <td class="text-center">{{ p.votes }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  {% endif %}
</div>
{% endblock %}

{% block javascripts_head %}
  {% if proximite_mensuelle.series %}
    <script src="{{ asset('assets/js/dist/chart.min.js') }}"></script>
  {% endif %}
{% endblock %}

{% block javascripts %}
  {% if proximite_mensuelle.series %}
    <script>
      document.addEventListener('DOMContentLoaded', function () {
        new Chart(document.getElementById('proximite-mensuelle'), {
          type: 'line',
          data: {
            labels: {{ proximite_mensuelle.mois|map(m => m|mois_abrege)|json_encode|raw }},
            datasets: [
              {% for serie in proximite_mensuelle.series %}
                {
                  label: {{ serie.groupe|json_encode|raw }},
                  data: {{ serie.scores|json_encode|raw }},
                  borderColor: {{ serie.couleur|json_encode|raw }},
                  borderWidth: 2,
                  fill: false,
                  tension: 0.4,
                  // Un mois sans scrutin commun laisse un trou plutôt qu'un zéro.
                  spanGaps: false
                }{{ not loop.last ? ',' : '' }}
              {% endfor %}
            ]
          },
          options: {
            responsive: true,
            scales: { y: { min: 0, max: 100, ticks: { callback: v => v + ' %' } } },
            plugins: { datalabels: { display: false }, legend: { display: true } }
          }
        });
      });
    </script>
  {% endif %}
{% endblock %}
