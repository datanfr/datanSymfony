# Réécriture d'URL pour Apache et LiteSpeed (l'hébergement de production tourne
# sous LiteSpeed, qui lit les .htaccess). Sans ce fichier, seuls les fichiers
# réellement présents sur le disque sont servis : /robots.txt répond, mais
# /vote/17/491 et toutes les autres routes tombent sur le 404 du serveur web
# sans jamais atteindre Symfony.
#
# Contenu de symfony/apache-pack, que nous n'installons pas comme dépendance :
# le fichier ne change jamais et le paquet n'apporte rien d'autre.

DirectoryIndex index.php

# MultiViews ferait deviner au serveur l'extension d'un fichier absent et
# court-circuiterait la règle de réécriture finale.
<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Détermine le préfixe d'URL sous lequel l'application est servie, pour que
    # les règles suivantes fonctionnent aussi dans un sous-répertoire.
    RewriteCond %{REQUEST_URI}::$0 ^(/.+)/(.*)::\2$
    RewriteRule .* - [E=BASE:%1]

    # Certains serveurs n'exposent pas l'en-tête Authorization à PHP : sans
    # cette règle, l'authentification par jeton se perd en route.
    RewriteCond %{HTTP:Authorization} .+
    RewriteRule ^ - [E=HTTP_AUTHORIZATION:%0]

    # Une même page ne doit pas répondre à deux adresses : /index.php/truc
    # redirige en 301 vers /truc. Le référencement de datan.fr en dépend.
    RewriteCond %{ENV:REDIRECT_STATUS} =""
    RewriteRule ^index\.php(?:/(.*)|$) %{ENV:BASE}/$1 [R=301,L]

    # Un fichier qui existe (assets, robots.txt, images) est servi tel quel.
    RewriteCond %{REQUEST_FILENAME} -f
    RewriteRule ^ - [L]

    # Tout le reste passe par le contrôleur frontal.
    RewriteRule ^ %{ENV:BASE}/index.php [L]
</IfModule>

<IfModule !mod_rewrite.c>
    <IfModule mod_alias.c>
        RedirectMatch 307 ^/$ /index.php/
    </IfModule>
</IfModule>
